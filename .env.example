# ==============================================================================
# ENVIRONMENT VARIABLES - RESTAURANT ORDERING PLATFORM
# Copy this file to .env before starting the platform
# ==============================================================================

NODE_ENV=development

# ------------------------------------------------------------------------------
# HOST PORTS (Customized to avoid conflicts with existing services)
# ------------------------------------------------------------------------------
WEB_PORT=3001
API_PORT=4000
DB_PORT=5435
REDIS_PORT=6381
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MAILPIT_SMTP_PORT=1025
MAILPIT_DASHBOARD_PORT=8025

# ------------------------------------------------------------------------------
# URLS FOR CORS & REDIRECTS
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=restaurant_secret_password
POSTGRES_DB=restaurant_platform
DATABASE_URL="postgresql://restaurant_user:restaurant_secret_password@localhost:5435/restaurant_platform?schema=public"
# In docker network:
DOCKER_DATABASE_URL="postgresql://restaurant_user:restaurant_secret_password@postgres:5432/restaurant_platform?schema=public"

# ------------------------------------------------------------------------------
# REDIS (BullMQ & Cache)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_URL="redis://localhost:6381"
DOCKER_REDIS_URL="redis://redis:6379"

# ------------------------------------------------------------------------------
# S3 / MinIO (Image Storage)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminsecret
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=restaurant-menu-images
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminsecret
S3_FORCE_PATH_STYLE=true
NEXT_PUBLIC_IMAGES_BASE_URL=http://localhost:9000/restaurant-menu-images

# ------------------------------------------------------------------------------
# SMTP / Mailpit (Emails)
# ------------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@mirestaurante.com.co
SMTP_FROM_NAME="Plataforma Restaurante"

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=super_secret_access_jwt_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=super_cookie_secret_for_table_sessions_min_32_chars

# ------------------------------------------------------------------------------
# WOMPI SANDBOX (Colombia)
# Default official public sandbox keys for development
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_stag_test_g2u0q2587829a2829a829a
WOMPI_PRIVATE_KEY=prv_stag_test_9281a829a8291a8291a8291a
WOMPI_EVENTS_SECRET=stag_events_secret_mock_test_key_colombia
WOMPI_INTEGRITY_SECRET=stag_integrity_secret_mock_test_key_colombia
WOMPI_API_URL=https://sandbox.wompi.co/v1

# ------------------------------------------------------------------------------
# ELECTRONIC INVOICING (DIAN Colombia)
# Options: 'fake' (default local development) | 'factus' | 'alegra'
# ------------------------------------------------------------------------------
INVOICE_PROVIDER=fake
FACTUS_API_URL=https://api-sandbox.factus.com.co
FACTUS_CLIENT_ID=factus_client_id_placeholder
FACTUS_CLIENT_SECRET=factus_client_secret_placeholder

# ------------------------------------------------------------------------------
# WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BDm3...placeholder_generate_with_web_push
VAPID_PRIVATE_KEY=placeholder_generate_with_web_push
VAPID_SUBJECT=mailto:soporte@mirestaurante.com.co
